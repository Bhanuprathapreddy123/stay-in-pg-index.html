@charset "utf-8";

:root { --forest: #1e3a2f; --forest-2: #142820; --gold: #d4af37; --cream: #fbfbfa; --ink: #1a1a1a; --muted: #65706a; --line: #e5e9e5; --serif: 'Playfair Display',serif; --quote: 'Cormorant Garamond',serif; --sans: 'Manrope',sans-serif; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { font-family: var(--sans); background: var(--cream); color: var(--ink); }

button, a { font-family: inherit; }

button { cursor: pointer; }

.site { overflow: hidden; }

.nav { height: 84px; position: absolute; z-index: 10; top: 0px; left: 0px; right: 0px; display: flex; align-items: center; padding: 0px clamp(20px, 5vw, 82px); color: rgb(255, 255, 255); gap: 32px; background: linear-gradient(rgba(0, 0, 0, 0.4), transparent); transition: 0.3s; }

.logo { display: flex; align-items: center; gap: 11px; text-decoration: none; color: inherit; flex-shrink: 0; }

.logo-mark { width: 34px; height: 34px; border: 1px solid var(--gold); border-radius: 50%; display: grid; place-items: center; color: var(--gold); font: italic 23px var(--serif); }

.logo strong { display: block; font-size: 13px; letter-spacing: 0.13em; line-height: 1.1; }

.logo small { display: block; font-size: 7px; letter-spacing: 0.22em; margin-top: 4px; opacity: 0.72; }

.desktop-nav { display: flex; gap: 25px; margin-left: auto; }

.desktop-nav button, .footer-links button { border: 0px; background: transparent; color: inherit; font-size: 11px; letter-spacing: 0.04em; position: relative; }

.desktop-nav button::after { content: ""; height: 1px; background: var(--gold); position: absolute; left: 0px; right: 100%; bottom: -7px; transition: 0.25s; }

.desktop-nav button:hover::after { right: 0px; }

.nav-cta, .button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; text-decoration: none; border: 0px; transition: transform 0.25s, box-shadow 0.25s, background 0.25s; }

.nav-cta { border: 1px solid rgba(255, 255, 255, 0.5); padding: 12px 17px; border-radius: 999px; color: rgb(255, 255, 255); text-decoration: none; font-size: 11px; }

.nav-cta:hover, .button:hover { transform: translateY(-3px); box-shadow: rgba(0, 0, 0, 0.133) 0px 12px 25px; }

.menu-btn { display: none; background: none; border: 0px; color: rgb(255, 255, 255); }

.hero { height: min(850px, 100vh); min-height: 680px; position: relative; display: flex; align-items: flex-end; color: rgb(255, 255, 255); }

.hero-image, .cta-band > img { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: center center; }

.hero-overlay, .cta-overlay { position: absolute; inset: 0px; background: linear-gradient(90deg, rgba(12, 25, 19, 0.82) 0%, rgba(12, 25, 19, 0.45) 47%, rgba(12, 25, 19, 0.1) 100%); }

.hero-content { position: relative; z-index: 1; margin: 0px clamp(20px, 8vw, 128px) 10%; max-width: 675px; }

.eyebrow, .section-kicker { font-size: 10px; letter-spacing: 0.21em; font-weight: 800; text-transform: uppercase; }

.eyebrow { display: flex; gap: 7px; align-items: center; margin-bottom: 25px; color: var(--gold); }

h1, h2, h3, p { margin: 0px; }

h1 { font: 500 clamp(42px,6.5vw,88px)/.99 var(--serif); letter-spacing: -0.04em; }

h1 em, h2 em { font-style: italic; color: var(--gold); }

.hero-content > p { font-size: 15px; line-height: 1.85; color: rgb(238, 241, 236); max-width: 525px; margin: 29px 0px; }

.hero-actions { display: flex; align-items: center; gap: 24px; }

.button { padding: 15px 23px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.02em; }

.gold { background: var(--gold); color: rgb(24, 38, 31); }

.text-button { display: inline-flex; align-items: center; gap: 10px; color: rgb(255, 255, 255); background: none; border: 0px; font-size: 12px; font-weight: 700; }

.hero-meta { display: flex; gap: 25px; margin-top: 65px; font-size: 10px; color: rgb(223, 231, 223); }

.hero-meta span { display: flex; align-items: center; gap: 7px; }

.float-card { position: absolute; z-index: 2; background: rgba(255, 255, 255, 0.94); color: var(--ink); box-shadow: rgba(0, 0, 0, 0.2) 0px 15px 40px; border-radius: 14px; padding: 15px 19px; }

.rating-card { right: 10%; top: 30%; display: flex; flex-direction: column; gap: 5px; animation: 5s ease-in-out 0s infinite normal none running float; }

.rating-card span:last-child { font-size: 10px; color: var(--muted); }

.big-rating { font-size: 23px; font-weight: 800; color: var(--forest); display: flex; align-items: center; gap: 5px; }

.big-rating svg { color: var(--gold); }

.comfort-card { right: 14%; bottom: 18%; font: italic 20px var(--quote); color: var(--forest); }

.comfort-card i { color: var(--gold); font-style: normal; }

.trust-strip { display: flex; justify-content: center; gap: clamp(20px, 4vw, 65px); padding: 22px 20px; border-bottom: 1px solid var(--line); white-space: nowrap; overflow: auto; background: rgb(255, 255, 255); }

.trust-strip span { display: flex; gap: 9px; align-items: center; color: var(--muted); font-size: 10px; font-weight: 700; }

.trust-strip svg { color: var(--gold); }

.section { max-width: 1200px; margin: auto; padding: 125px 28px; }

.section-kicker { color: var(--forest); margin-bottom: 21px; }

.section h2, .food-band h2, .cta-band h2, .reviews h2 { font: 500 clamp(38px,5vw,66px)/1.06 var(--serif); letter-spacing: -0.045em; }

.section h2 em { color: var(--forest); font-weight: 500; }

.intro-grid { display: grid; grid-template-columns: 1.04fr 0.84fr; gap: 11%; align-items: center; margin-top: 65px; }

.image-frame { position: relative; }

.image-frame img { width: 100%; aspect-ratio: 1.1 / 1; object-fit: cover; border-radius: 18px; display: block; }

.image-note { position: absolute; right: -35px; bottom: 32px; background: rgb(255, 255, 255); padding: 17px 21px; border-radius: 10px; font: italic 18px var(--quote); color: var(--muted); box-shadow: rgba(0, 0, 0, 0.067) 0px 10px 28px; }

.image-note strong { color: var(--forest); font-weight: 600; }

.lead { font: 500 20px/1.65 var(--serif); color: var(--forest); }

.feature-list { display: grid; grid-template-columns: 1fr 1fr; gap: 17px; margin-top: 32px; }

.feature-list span, .room-features span { display: flex; align-items: center; gap: 9px; font-size: 11px; font-weight: 600; color: var(--muted); }

.feature-list svg, .room-features svg { color: var(--gold); }

.quote-break { display: flex; justify-content: center; align-items: center; gap: 50px; padding: 45px 20px; background: rgb(241, 238, 231); color: var(--forest); text-align: center; }

.quote-break span { font: 80px var(--quote); color: var(--gold); height: 50px; }

.quote-break p { font: italic 27px/1.1 var(--quote); }

.rooms-section { max-width: 1300px; }

.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 30px; }

.section-heading p { max-width: 290px; color: var(--muted); font-size: 13px; line-height: 1.7; }

.room-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 60px; }

.room-card { background: rgb(255, 255, 255); border-radius: 15px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.06) 0px 8px 30px; transition: 0.3s; height: 100%; }

.room-card:hover { transform: translateY(-7px); box-shadow: rgba(0, 0, 0, 0.094) 0px 20px 40px; }

.room-photo { position: relative; overflow: hidden; }

